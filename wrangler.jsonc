{
  // Nur lokal (npm run dev). Nicht deployt.
  // Der Worker hat genau eine Aufgabe: /api/judge, das unscharfe AI-Urteil bei
  // Grenzfällen. Alles andere läuft im Browser mit Demo-Daten.
  // Workers AI Free: Beim Überschreiten gibt es Fehler, keine Rechnung. Dann
  // bleibt der Regel-Score stehen (Fallback in src/judge.ts).
  "name": "revenue-loop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // Bremse je Besucher: der Browser fragt höchstens 30 Urteile pro Sitzung.
  // namespace_id ist kontoweit geteilt. Belegt: 4711 GTM OS, 4712 Lead Table + Sync Board, 4713 SDR Radar, 4714 Revenue Loop.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4714", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": { "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct" },
  "observability": { "enabled": false }
}
